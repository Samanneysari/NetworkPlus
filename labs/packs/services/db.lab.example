$TTL 300
@ IN SOA ns1.lab.example. hostmaster.lab.example. (
  2026082501  ; serial
  3600        ; refresh
  600         ; retry
  86400       ; expire
  300         ; negative cache
)
  IN NS ns1.lab.example.
ns1 IN A 10.40.20.10
app IN A 10.40.20.80
app IN AAAA 2001:db8:40:20::80
www IN CNAME app.lab.example.
@ IN MX 10 mail.lab.example.
mail IN A 10.40.20.25
@ IN TXT "network-plus-lab"
